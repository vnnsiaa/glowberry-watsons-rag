# ==== Groq (wajib untuk jawaban AI) ====
# Buat API key di https://console.groq.com/keys. Jangan commit nilai aslinya.
GROQ_API_KEY=isi_api_key_groq
GROQ_MODEL=qwen/qwen3.8-27b
# Model cadangan bila model utama gagal (dipisah koma)
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_MAX_TOKENS=1024
GROQ_TIMEOUT_MS=20000

# ==== RAG ====
RAG_TOP_K=8

# ==== Server persisten / WhatsApp Gateway (server-v2.js) ====
PORT=3001
AUTO_START_BOT=false
# Wajib diisi bila gateway dapat diakses dari internet
ADMIN_TOKEN=
# Origin yang boleh memanggil gateway, mis. https://glowberry-watsons-rag.vercel.app
ALLOWED_ORIGINS=
# Lokasi penyimpanan sesi WhatsApp (default ./.wwebjs_auth)
WA_SESSION_DIR=
WA_CACHE_DIR=
# Path Chrome/Chromium bila tidak memakai Chrome bawaan Puppeteer
PUPPETEER_EXECUTABLE_PATH=

# ==== Khusus Vercel ====
# URL publik server-v2.js (WhatsApp Gateway). Kosongkan bila tidak ada.
WA_GATEWAY_URL=
